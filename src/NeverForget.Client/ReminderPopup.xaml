<Window x:Class="NeverForget.Client.ReminderPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reminder" Width="520" MinHeight="300" SizeToContent="Height"
        MaxHeight="650" WindowStartupLocation="CenterScreen" Topmost="True"
        ResizeMode="NoResize" ShowInTaskbar="True" Background="#17213C">
    <Border Padding="28">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="REMINDER" Foreground="#8EA6FF" FontWeight="Bold" FontSize="13" />
            <TextBlock x:Name="TitleTextBlock" Grid.Row="1" Foreground="White" FontSize="27"
                       FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,14" />
            <ScrollViewer Grid.Row="2" MaxHeight="360" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="MessageTextBlock" Foreground="#E7EBF5" FontSize="17"
                               TextWrapping="Wrap" LineHeight="26" />
                    <TextBlock x:Name="ScheduledAtTextBlock" Foreground="#9DA8C0" FontSize="13"
                               Margin="0,18,0,0" />
                </StackPanel>
            </ScrollViewer>
            <Button Grid.Row="3" Content="OK" Width="130" Height="44" Margin="0,26,0,0"
                    HorizontalAlignment="Center" Background="#5B7CFA" Foreground="White"
                    FontSize="16" FontWeight="SemiBold" Click="OkButton_Click" />
        </Grid>
    </Border>
</Window>
